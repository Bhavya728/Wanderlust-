<%- layout("layouts/boilerplate") %>

<div class="row mt-5">
    <div class="col-8 offset-2">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><%= err.statusCode %>: <%= err.message %></h4>
            <% if (process.env.NODE_ENV !== "production") { %>
                <p class="mb-0"><%= err.stack %></p>
            <% } %>
        </div>
    </div>
</div>
